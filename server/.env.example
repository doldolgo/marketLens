# MarketLens server env 예시 — 복사해서 server/.env 를 만들고 값은 **사람**이 채운다.
# Claude 세션은 .env 를 읽지도 쓰지도 않는다 (CLAUDE.md §5). 이 예시 파일이 키 목록의 진실이다.
# 전부 선택값 — 없으면 해당 기능만 꺼진다 (docs/context/dev-setup.md 참고).

# 프로세스 역할(016): collector(기본) | api. 로컬은 비워 둔다 — api 는 compose 의 api 서비스만 environment 로 준다.
# ROLE=

# InfluxDB 2.7 접속. 토큰이 없으면 저장 루프 비활성·/history/* 503, 앱은 뜬다.
INFLUX_URL=http://localhost:8086
# dev compose 첫 기동 전에 정한다 — setup 이 이 값을 admin 토큰으로 쓴다. 생성: openssl rand -hex 32
INFLUX_TOKEN=

# Redis 7 접속(009 — 틱 버퍼). 없으면 기본값. compose 안에서는 redis://redis:6379/0 으로 덮어쓴다.
REDIS_URL=redis://localhost:6379/0

# 설정 시 POST /refresh 에 X-Refresh-Token 헤더가 필요하다. 생성: openssl rand -hex 32
REFRESH_TOKEN=

# 거래소 원문 아카이브 S3 저장(010, 접두사 raw/). 버킷이 없으면 아카이브 비활성, 앱은 뜬다.
# AWS 키는 넣지 않는다 — 로컬은 `aws configure`(~/.aws), EC2 는 인스턴스 IAM 역할.
S3_BUCKET=
S3_REGION=ap-northeast-2

# 거래소 입출금 상태 조회용. 없으면 해당 거래소 상태는 null(모름). 빗썸은 키 불필요.
UPBIT_API_KEY=
UPBIT_SECRET_KEY=
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BYBIT_API_KEY=
BYBIT_SECRET_KEY=

# Slack Incoming Webhook URL(025). 있으면 기동·수집 실패 60초 구간 발생/복구·ERROR 로그·처리 안 된 500 이
# 채널로 간다(키별 10분 억제). 없으면 알림 기능 전체가 꺼진다 — 로컬은 비워 둔다. 값은 로그·응답에 찍히지 않는다.
SLACK_WEBHOOK_URL=

# StatsD 수신 주소 host:port(027). compose 가 api 에만 host.docker.internal:8125(serve 호스트의 CloudWatch Agent)를 준다.
# 있으면 api 가 WS 접속 수 게이지를 10초마다 UDP 로 보낸다. 로컬은 비워 둔다 — 비면 게이지를 띄우지 않는다.
# STATSD_ADDR=

# Clarity Data Export 토큰(035) — serve 의 api 만 쓴다(collect 에는 넣지 않는다). 비면 관리자 페이지의 Clarity 부분이 꺼진다(호출 0).
# CLARITY_API_TOKEN=

# 이더리움 노드 주소 둘(050) — WS 는 업비트 ERC-20 Transfer 로그·newHeads 구독, HTTP 는 공백 재생(eth_getLogs)·블록 조회.
# 둘 다 있어야 입출금 감지기가 켜진다(하나라도 비면 경고 1줄, 감지기 없이 뜬다 — API 는 Influx 의 기존 점만 준다).
# 기본값은 공개 노드 publicnode(키 없음·무료·rate limit 미공개). Ankr 은 이 플랜에서 WS 401 이라 쓰지 않는다.
# ETH_WS_URL=wss://ethereum-rpc.publicnode.com
# ETH_HTTP_URL=https://ethereum-rpc.publicnode.com
