# 023 — TLS 앞단. serve 박스에서 caddy 가 호스트 80·443 을 쥐고 nginx(web 컨테이너) 로 넘긴다.
# 인증서는 Let's Encrypt 자동 발급·갱신, 저장은 compose 볼륨 caddy-data(재기동·재배포에도 재발급하지 않는다).
# 027 — 이 파일은 caddy/ 디렉터리째 바인드된다. 파일 하나를 바인드하면 git 이 새 파일로 바꿔 써도 컨테이너는
#   옛 내용을 본다. serve 배포가 up 뒤에 `caddy reload` 로 다시 읽힌다 — 깨진 설정은 다음 caddy 재시작에서
#   사이트 전체를 내리므로, 고친 PR 은 로컬 `caddy validate` 결과를 본문에 적는다.
# 032 — 단 `output file` 블록(roll_*)은 reload 로 바뀌지 않는다 — caddy 가 파일 writer 를 파일 이름으로 재사용한다
#   (2.11.4 로컬 재현, format 의 지우기 규칙은 reload 로 바뀐다). 그 블록을 고친 배포 뒤엔 사람이 serve 에서
#   `docker compose --profile serve --env-file .env --env-file server/.env up -d --force-recreate caddy` 로
#   caddy 를 한 번 다시 만든다(몇 초 끊김, 인증서는 볼륨에 있다).
{
	# HTTP/3(UDP 443)는 compose 에서 안 열므로 광고하지 않는다 — 브라우저가 QUIC 을 헛시도하지 않게
	servers {
		protocols h1 h2
	}
	# 027 §3.2 — 기본 로거(오류 줄 — 예: 업스트림 502. docker 로그로 간다)에도 접속 로그와 같은 지우기 규칙.
	# docker 로그에 원 IP·검색어가 남지 않게. 아래 access_log 조각의 format 과 같아야 한다(test_observability.py 가 본다).
	# 032 — 단 IP 두 필드는 자르지 않고 지운다. 오류 줄에는 IP 가 필요 없고, docker 로그는 크기로만 회전해 방문이 적으면
	# 처리방침의 90일보다 오래 남는다.
	log default {
		format filter {
			wrap json
			request>headers delete
			resp_headers delete
			request>remote_ip delete
			request>client_ip delete
			request>uri query {
				delete s.q
				delete g.q
				delete p.q
			}
		}
	}
}

# 027 §3.2 — 접속 로그. 개인정보로 다룬다 — 한 줄에 남기는 것은 허용 목록이다.
# 도메인 블록만 불러온다. http:// catch-all(탄력 IP 직접 접속·봇 스캔)은 기록하지 않는다.
(access_log) {
	# 폴링·감시가 방문 기록을 덮지 않게 — 수집 상태 탭 5초·랜딩 10초·기록 탭 60초·uptime·canary
	@nolog path /api/health /api/health/collect /api/landing /api/history/events /api/history/candles
	log_skip @nolog
	@canary header User-Agent *KimpTrack-Canary*
	log_skip @canary

	# 요청 헤더는 통째로 지우고 두 필드만 덧붙인다. referer 는 http(s) 스킴+호스트(+포트)만 — 그 모양이
	# 아니면(android-app://·빈 값·사용자 정보가 든 주소) 빈 값. 경로·쿼리에는 검색어가 실릴 수 있다.
	map {http.request.header.Referer} {referer_origin} {
		~(?i)^(https?://(?:[a-z0-9.-]+|\[[0-9a-f:.]+\])(?::[0-9]+)?)(?:[/?#].*)?$ "${1}"
		default ""
	}
	log_append ua {http.request.header.User-Agent}
	log_append referer {referer_origin}

	log {
		# 호스트 ./logs/caddy/ (compose 바인드, git 무시). 0644 — 사람이 호스트에서 읽게.
		# 032 — 하루(또는 50MiB)마다 회전, gzip 된 회전 파일 100개(하루 1개 × 90일 + 크기 회전 여유), 회전 파일은 90일 뒤
		# 지운다(지우기는 회전 때 돌아 최대 2일 늦다 — 처리방침의 파기 기한 5일 안). 크기로만 회전하면 방문이 적을 때
		# 90일보다 오래된 줄이 현재 파일에 남는다. roll_interval 은 Caddy 2.11 부터다.
		output file /var/log/caddy/access.log {
			mode 0644
			roll_size 50MiB
			roll_interval 24h
			roll_keep 100
			roll_keep_for 90d
		}
		format filter {
			wrap json
			# 헤더 통째 — Accept-Language·Sec-Ch-Ua·임의 헤더가 합쳐지면 방문자를 가려낸다.
			# 응답 Location 에는 022 의 301 이 쿼리(검색어 포함)를 그대로 싣는다.
			request>headers delete
			resp_headers delete
			# 두 필드는 지금 같은 값이라 하나만 자르면 원본이 남는다
			request>remote_ip ip_mask {
				ipv4 24
				ipv6 48
			}
			request>client_ip ip_mask {
				ipv4 24
				ipv6 48
			}
			# 스프레드·갭·선선갭 검색어. 나머지 키(utm_*·tab 등)는 어떤 주소로 들어왔는지 보려고 남긴다
			request>uri query {
				delete s.q
				delete g.q
				delete p.q
			}
		}
	}
}

# 도메인 — 자동 HTTPS. http://kimptrack.com 은 caddy 가 https 로 308 리다이렉트한다(설정 없이 기본 동작).
kimptrack.com {
	import access_log
	# 027 §3.2 — 브라우저 기본값은 같은 출처 요청에 전체 URL(검색어 포함)을 Referer 로 보낸다
	header Referrer-Policy strict-origin
	reverse_proxy web:80
}

# 023·022 — www 는 경로·쿼리를 들고 apex 로 301. 검색엔진이 두 호스트를 같은 본문의 사본으로 따로 모으지 않게
# (네이버는 메인 페이지 중복을 canonical 보다 리다이렉트로 합치라고 한다). http://www 도 한 번에 apex https 로.
# 인증서는 www 도 계속 발급된다. 접속 기록은 남기지 않는다 — 본문이 없는 리다이렉트뿐이다
www.kimptrack.com, http://www.kimptrack.com {
	redir https://kimptrack.com{uri} permanent
}

# 그 밖의 호스트(탄력 IP 직접 접속·로컬 :WEB_PORT)는 평문 HTTP 그대로 — 인증서 없음, 리다이렉트 없음.
# 022 — 같은 본문이 IP 주소로 색인되지 않게 X-Robots-Tag noindex(로컬 확인에는 영향 없음)
http:// {
	header X-Robots-Tag "noindex"
	reverse_proxy web:80
}
